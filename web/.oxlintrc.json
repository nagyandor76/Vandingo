{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/screens/Practice.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": [{ "group": ["**/practice/engine*"], "message": "The Practice screen renders the Practice module's snapshot; import from practice/practice.ts, never the engine." }] }
        ]
      }
    }
  ]
}
