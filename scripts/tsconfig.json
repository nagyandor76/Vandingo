{
  // Typecheck only: Node runs the scripts directly by stripping the types.
  // Uses the compiler and Node types already installed for the frontend (web/node_modules).
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "typeRoots": ["../web/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["*.ts"]
}
